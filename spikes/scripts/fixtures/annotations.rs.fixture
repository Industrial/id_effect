use crate::prelude::*;

#[env(forward(Logger, Db))]
struct Shared;

// corpus:begin H01
fn hello() -> Effect<String, Never, caps!(Greeting)> {
  need::<Greeting>().map(|g| g.0.to_string())
}
// corpus:end H01

// corpus:begin H02
pub fn generic<R, I>(
  x: u32,
) -> Effect<u32, Never, R>
where
  R: Selector<Logger, I>,
{
  let y: u32 = x;
  let (a, b): (u32, u32) = (y, y);
  run(|r: &mut R| succeed(a + b)).narrow::<caps!(Logger, Db), (Here, There<Here>)>()
}
// corpus:end H02

