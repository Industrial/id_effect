+/// The batch window of [`RpcClient::call_value`] for callers in the environment `R` (a
+/// request joins the window of its own fiber, so the resolver is typed by the caller's env).
+fn batcher_in<R: Send + Sync + 'static>() -> RequestResolver<Pending, R> {
+  type Batchers = Mutex<HashMap<TypeId, Box<dyn Any + Send + Sync>>>;
+  static BATCHERS: OnceLock<Batchers> = OnceLock::new();
+  let fresh = || {
+    RequestResolver::<Pending, R>::make_batched(|calls| {
+      let n = calls.len();
+      let window = send_window(calls, CLIENT_BATCH_MAX_CALLS, CLIENT_BATCH_MAX_BYTES);
+      // The window's requests need no env: run them as their own root, under any `R`.
+      from_async(move || async move {
+        Ok(
+          match id_effect_axum::run_with_env(HNil, move |_| window).await {
+            Exit::Success(answers) => answers,
+            Exit::Failure(_) => vec![Ok(Answer::Protocol(NO_RESULT.to_owned())); n],
+          },
+        )
+      })
+    })
+  };
+  let mut batchers = BATCHERS
+    .get_or_init(Mutex::default)
+    .lock()
+    .unwrap_or_else(PoisonError::into_inner);
+  batchers
+    .entry(TypeId::of::<RequestResolver<Pending, R>>())
+    .or_insert_with(|| Box::new(fresh()))
+    .downcast_ref::<RequestResolver<Pending, R>>()
+    .map_or_else(fresh, Clone::clone)
+}
