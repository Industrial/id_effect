{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "scorecard.schema.json",
	"title": "id_effect platform scorecard",
	"description": "Structure of docs/scorecard/scorecard.json (METHOD.md). scripts/scorecard.sh --validate enforces this schema with jq, plus the cross references a schema cannot express: row ids are unique, every row's group is a groups[].id, every row's track is a tracks key, every group has at least one row, frameworks[0] is id_effect and competitor_order lists the other frameworks in order; on a row with checks (method v2, METHOD.md §7), check ids are unique and start with \"<row id>#\", v2.level and v2.met cover exactly the frameworks (id_effect: exactly its score versions), and v2.met, v2.evidence and v2.notes name only known check ids and frameworks.",
	"type": "object",
	"required": [
		"schema_version",
		"method_version",
		"method_doc",
		"competitor_snapshot",
		"frameworks",
		"groups",
		"tracks",
		"competitor_order",
		"rows"
	],
	"properties": {
		"schema_version": { "const": 1 },
		"method_version": {
			"type": "string",
			"description": "METHOD.md version the scores follow (e.g. \"2.0\"). From 2.0 the stored scores are checklist scores and each row keeps method 1.1 in v1 (METHOD.md §7.4)."
		},
		"method_doc": { "type": "string" },
		"competitor_snapshot": {
			"type": "object",
			"required": ["date"],
			"properties": {
				"date": { "type": "string", "format": "date" },
				"assessor": { "type": "string" }
			}
		},
		"frameworks": {
			"type": "array",
			"description": "The 11 columns; the first is id_effect, then the competitors in competitor_order.",
			"minItems": 11,
			"maxItems": 11,
			"prefixItems": [{ "properties": { "id": { "const": "id_effect" } } }],
			"items": {
				"type": "object",
				"required": ["id", "name", "scope"],
				"properties": {
					"id": { "type": "string" },
					"name": { "type": "string" },
					"scope": { "type": "string" }
				}
			}
		},
		"groups": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["id", "name", "w_enterprise", "w_runtime"],
				"properties": {
					"id": { "type": "string" },
					"name": { "type": "string" },
					"w_enterprise": { "type": "number", "minimum": 0 },
					"w_runtime": { "type": "number", "minimum": 0 }
				}
			}
		},
		"tracks": {
			"type": "object",
			"description": "Track id -> name; rows[].track references a key.",
			"additionalProperties": { "type": "string" }
		},
		"competitor_order": {
			"type": "array",
			"description": "Framework ids that rows[].competitors[i] score, in order.",
			"minItems": 10,
			"maxItems": 10,
			"uniqueItems": true,
			"items": { "type": "string" }
		},
		"rows": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/row" }
		}
	},
	"$defs": {
		"score": { "type": "integer", "minimum": 1, "maximum": 100 },
		"semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
		"versionScores": {
			"type": "object",
			"description": "Version (x.y.z) -> score.",
			"propertyNames": { "$ref": "#/$defs/semver" },
			"additionalProperties": { "$ref": "#/$defs/score" }
		},
		"row": {
			"type": "object",
			"required": [
				"id",
				"group",
				"name",
				"measures",
				"competitors",
				"track",
				"stance",
				"id_effect",
				"evidence",
				"targets"
			],
			"properties": {
				"id": {
					"type": "string",
					"description": "Stable row id (<group>.<slug>); never changes."
				},
				"group": { "type": "string", "description": "A groups[].id." },
				"name": { "type": "string" },
				"measures": { "type": "string" },
				"competitors": {
					"type": "array",
					"minItems": 10,
					"maxItems": 10,
					"items": { "$ref": "#/$defs/score" }
				},
				"track": { "type": "string", "description": "A tracks key." },
				"stance": {
					"enum": [
						"build",
						"promote",
						"integrate",
						"maintain",
						"non-goal",
						"partial-non-goal"
					]
				},
				"id_effect": {
					"$ref": "#/$defs/versionScores",
					"description": "Measured id_effect score per release.",
					"minProperties": 1
				},
				"evidence": { "type": "string" },
				"targets": {
					"$ref": "#/$defs/versionScores",
					"description": "Planned id_effect score per release (METHOD.md §5.1)."
				},
				"adr": {
					"type": "object",
					"description": "Optional. Version (x.y.z) -> why the id_effect score may drop by 5 or more at that release (scorecard.sh --diff; PLAN-OF-PLANS §7.3).",
					"propertyNames": { "$ref": "#/$defs/semver" },
					"additionalProperties": { "type": "string", "minLength": 1 }
				},
				"v1": {
					"type": "object",
					"description": "Method 2.x only: the method 1.1 history of the row (scripts/scorecard.sh --method 1; METHOD.md §7.4). id_effect scores the same versions as the row's id_effect.",
					"required": ["competitors", "id_effect", "targets"],
					"properties": {
						"competitors": {
							"type": "array",
							"minItems": 10,
							"maxItems": 10,
							"items": { "$ref": "#/$defs/score" }
						},
						"id_effect": { "$ref": "#/$defs/versionScores" },
						"targets": { "$ref": "#/$defs/versionScores" }
					}
				},
				"checks": {
					"type": "array",
					"description": "Method v2 table-stakes checks (METHOD.md §7). Ids are unique and start with \"<row id>#\". A row with checks needs v2.",
					"minItems": 4,
					"maxItems": 8,
					"items": {
						"type": "object",
						"required": ["id", "text"],
						"properties": {
							"id": {
								"type": "string",
								"pattern": "^[a-z]+\\.[a-z0-9-]+#[0-9]+$"
							},
							"text": { "type": "string", "minLength": 1 }
						}
					}
				},
				"v2": {
					"type": "object",
					"description": "Method v2 assessment (METHOD.md §7). level and met have an entry for every framework id; id_effect's entries are objects keyed by exactly the versions of the row's id_effect scores. met lists only ids from checks.",
					"required": ["level", "met"],
					"properties": {
						"level": {
							"type": "object",
							"properties": {
								"id_effect": {
									"type": "object",
									"propertyNames": { "$ref": "#/$defs/semver" },
									"additionalProperties": { "$ref": "#/$defs/level" }
								}
							},
							"additionalProperties": { "$ref": "#/$defs/level" }
						},
						"met": {
							"type": "object",
							"properties": {
								"id_effect": {
									"type": "object",
									"propertyNames": { "$ref": "#/$defs/semver" },
									"additionalProperties": { "$ref": "#/$defs/checkIds" }
								}
							},
							"additionalProperties": { "$ref": "#/$defs/checkIds" }
						},
						"evidence": {
							"type": "object",
							"description": "Check id -> where id_effect meets it (path, symbol or test).",
							"additionalProperties": { "type": "string", "minLength": 1 }
						},
						"notes": {
							"type": "object",
							"description": "Optional. Framework id -> why its v2 score differs from v1 (REPORT-method-v2.md).",
							"additionalProperties": { "type": "string", "minLength": 1 }
						}
					}
				}
			}
		},
		"level": {
			"description": "Method v2 maturity level; its cap is METHOD.md §3.2 (absent 9, labs 39, published 49, tested 69, documented 89, production 100).",
			"enum": [
				"absent",
				"labs",
				"published",
				"tested",
				"documented",
				"production"
			]
		},
		"checkIds": {
			"type": "array",
			"uniqueItems": true,
			"items": { "type": "string" }
		}
	}
}
