diff --git a/examples/reference/ledger/tests/invoices.rs b/examples/reference/ledger/tests/invoices.rs
new file mode 100644
index 0000000..4877b65
--- /dev/null
+++ b/examples/reference/ledger/tests/invoices.rs
@@ -0,0 +1,133 @@
+//! Invoices over typed routes: CRUD, the status flow, optimistic locking, voiding (a soft
+//! delete), ownership, and the tenant filter.
+
+mod common;
+
+use common::with_ledger;
+use id_effect_kit::sql::params;
+use id_effect_kit::test::http::StatusCode;
+use serde_json::{Value, json};
+
+#[tokio::test]
+async fn invoices_crud_and_status_flow() {
+  with_ledger(
+    |_, _| {},
+    |l| async move {
+      let team = l.team("acme").await;
+      let me = &team.accountant;
+      let receivable = l.accounts("acme", "acme-accountant", 1).await[0].id;
+
+      let raised = l
+        .post(
+          "/invoices",
+          json!({"number": "INV-1001", "customer": "Globex", "account_id": receivable, "amount": 12000}),
+          me,
+        )
+        .await;
+      raised.assert_status(StatusCode::CREATED);
+      let invoice: Value = raised.json().unwrap();
+      assert_eq!(invoice["status"], "draft");
+      assert_eq!(invoice["owner_id"], "acme-accountant");
+      let id = invoice["id"].as_i64().unwrap();
+
+      let list: Value = l.get("/invoices", &team.viewer).await.json().unwrap();
+      assert_eq!(list["invoices"].as_array().unwrap().len(), 1);
+      let path = format!("/invoices/{id}");
+
+      // A draft's amount changes; the version moves on, and a stale write is a 409.
+      let changed = l
+        .patch(&path, json!({"amount": 15000, "version": 1}), me)
+        .await;
+      changed.assert_status(StatusCode::OK);
+      assert_eq!(changed.json::<Value>().unwrap()["version"], 2);
+      l.patch(&path, json!({"status": "issued", "version": 1}), me)
+        .await
+        .assert_status(StatusCode::CONFLICT);
+      // draft → issued; skipping a status or editing an issued invoice is refused.
+      l.patch(&path, json!({"status": "issued", "version": 2}), me)
+        .await
+        .assert_status(StatusCode::OK);
+      l.patch(&path, json!({"amount": 1, "version": 3}), me)
+        .await
+        .assert_status(StatusCode::CONFLICT);
+      l.patch(&path, json!({"status": "draft", "version": 3}), me)
+        .await
+        .assert_status(StatusCode::UNPROCESSABLE_ENTITY);
+
+      // The same number twice in one organisation: 409; an unknown account: 422.
+      let again = json!({"number": "INV-1001", "customer": "Initech", "account_id": receivable, "amount": 1});
+      l.post("/invoices", again, me)
+        .await
+        .assert_status(StatusCode::CONFLICT);
+      let nowhere = json!({"number": "INV-1002", "customer": "Initech", "account_id": 999, "amount": 1});
+      l.post("/invoices", nowhere, me)
+        .await
+        .assert_status(StatusCode::UNPROCESSABLE_ENTITY);
+
+      // Voiding is a soft delete: gone from every query, still in the table.
+      l.delete(&path, me)
+        .await
+        .assert_status(StatusCode::NO_CONTENT);
+      l.get(&path, me).await.assert_status(StatusCode::NOT_FOUND);
+      let kept = l
+        .scalar(
+          "SELECT count(*)::int8 FROM invoices WHERE id = $1 AND voided_at IS NOT NULL",
+          params![id],
+        )
+        .await;
+      assert_eq!(kept, 1);
+    },
+  )
+  .await;
+}
+
+#[tokio::test]
+async fn invoices_are_guarded_and_tenant_scoped() {
+  with_ledger(
+    |_, _| {},
+    |l| async move {
+      let acme = l.team("acme").await;
+      let globex = l.team("globex").await;
+      let receivable = l.accounts("acme", "acme-owner", 1).await[0].id;
+      let body =
+        json!({"number": "INV-7", "customer": "Initech", "account_id": receivable, "amount": 500});
+
+      // A viewer reads but does not raise; Problem+JSON lists every invalid field.
+      l.post("/invoices", body.clone(), &acme.viewer)
+        .await
+        .assert_status(StatusCode::FORBIDDEN);
+      let invalid = l
+        .post(
+          "/invoices",
+          json!({"number": "7", "customer": "", "account_id": 0, "amount": 0}),
+          &acme.accountant,
+        )
+        .await;
+      invalid.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
+      assert_eq!(
+        invalid.problem().unwrap().extensions["errors"]
+          .as_array()
+          .unwrap()
+          .len(),
+        4
+      );
+
+      let raised = l.post("/invoices", body, &acme.owner).await;
+      raised.assert_status(StatusCode::CREATED);
+      let id = raised.json::<Value>().unwrap()["id"].as_i64().unwrap();
+      let path = format!("/invoices/{id}");
+
+      // Ownership: an accountant who did not raise it may not void it.
+      l.delete(&path, &acme.accountant)
+        .await
+        .assert_status(StatusCode::FORBIDDEN);
+      // The tenant filter: another organisation's invoice does not exist for globex.
+      l.get(&path, &globex.owner)
+        .await
+        .assert_status(StatusCode::NOT_FOUND);
+      let list: Value = l.get("/invoices", &globex.viewer).await.json().unwrap();
+      assert!(list["invoices"].as_array().unwrap().is_empty());
+    },
+  )
+  .await;
+}
