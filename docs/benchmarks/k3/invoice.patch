+-- Invoices, in minor units, booked against a receivable account of the same organisation.
+-- `version` is the optimistic-locking column; `voided_at` is the soft delete.
+CREATE TABLE invoices (
+  id BIGSERIAL PRIMARY KEY,
+  org_id TEXT NOT NULL REFERENCES orgs (id),
+  number TEXT NOT NULL,
+  customer TEXT NOT NULL,
+  account_id BIGINT NOT NULL REFERENCES accounts (id),
+  amount BIGINT NOT NULL CHECK (amount > 0),
+  status TEXT NOT NULL DEFAULT 'draft' CHECK (status IN ('draft', 'issued', 'paid')),
+  owner_id TEXT NOT NULL,
+  version BIGINT NOT NULL DEFAULT 1,
+  voided_at TIMESTAMPTZ,
+  UNIQUE (org_id, number)
+);
+
+CREATE INDEX invoices_org_id ON invoices (org_id, id);
