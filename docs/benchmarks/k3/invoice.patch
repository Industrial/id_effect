+/// The reminder: an invoice still issued (not paid, not voided) records when it was reminded;
+/// any other is done already. Rerunning it only moves `reminded_at`.
+fn remind(db: &Arc<dyn SqlClient>, job: InvoiceReminder) -> Effect<(), JobFailure, JobEnv> {
+  db.execute(
+    "UPDATE invoices SET reminded_at = now() \
