index 0000000..c4af61b
--- /dev/null
+++ b/examples/reference/ledger/src/invoices.rs
@@ -0,0 +1,352 @@
+//! Invoices: what an organisation bills its customers, booked against a receivable account.
+//!
+//! [`Invoice`] is an entity like [`Account`](crate::accounts::Account): the `Repository` scopes
+//! every statement to the caller's organisation, hides voided invoices (`soft_delete =
+//! "voided_at"`) and checks the `version` column on every update. An invoice moves `draft` →
+//! `issued` → `paid`; only a draft's customer and amount change, and a paid invoice is never
+//! voided.
+
+use std::sync::Arc;
+
+use axum::Json;
+use axum::http::StatusCode;
+use id_effect::schema::{self, HasSchema, ParseError, Schema, length, minimum, pattern};
+use id_effect::{Effect, fail, succeed};
+use id_effect_kit::authz::Policies;
+use id_effect_kit::axum::RequestCaps;
+use id_effect_kit::axum::route::{Input, Route, Router};
+use id_effect_kit::sql::query_builder::Dialect;
+use id_effect_kit::sql::{Entity, FromRow, Repository, with_transaction};
+use serde::Serialize;
+
+use crate::accounts::find_account;
+use crate::app::{App, AppEnv, Caller, as_caller, guarded};
+use crate::error::ApiError;
+
+/// One invoice. `org_id` is the tenant column the repository writes and filters by.
+#[derive(Clone, Debug, PartialEq, Serialize, id_effect::Schema, FromRow, Entity)]
+#[from_row(crate = id_effect_kit::sql)]
+#[entity(
+  crate = id_effect_kit::sql,
+  table = "invoices",
+  tenant = "org_id",
+  soft_delete = "voided_at"
+)]
+pub struct Invoice {
+  /// Assigned by the database.
+  #[entity(id, generated)]
+  pub id: i64,
+  /// The organisation.
+  pub org_id: String,
+  /// Invoice number, unique in the organisation (`INV-1001`).
+  pub number: String,
+  /// Who is billed.
+  pub customer: String,
+  /// The receivable account it is booked against.
+  pub account_id: i64,
+  /// Minor units, positive.
+  pub amount: i64,
+  /// `draft`, `issued` or `paid`.
+  pub status: String,
+  /// Who raised it (ownership: only they or an owner may change or void it).
+  pub owner_id: String,
+  /// Optimistic-locking version.
+  #[entity(version)]
+  pub version: i64,
+}
+
+/// `GET /invoices`.
+#[derive(Clone, Debug, Serialize, id_effect::Schema)]
+pub struct InvoiceList {
+  /// Open invoices, by id.
+  pub invoices: Vec<Invoice>,
+}
+
+/// The statuses, in the order an invoice moves through them.
+pub const STATUSES: [&str; 3] = ["draft", "issued", "paid"];
+
+/// The invoices of `org` (the tenant filter of every statement).
+pub fn invoices_of(org: &str) -> Repository<Invoice> {
+  Repository::new(Dialect::Postgres).with_tenant(org.to_owned())
+}
+
+/// `{id}` of the invoice routes: a positive id.
+pub struct InvoiceId;
+
+impl HasSchema for InvoiceId {
+  type A = i64;
+  type I = i64;
+  type E = ();
+
+  fn schema() -> Schema<i64, i64> {
+    minimum(schema::i64::<()>(), 1).describe("Invoice id")
+  }
+}
+
+/// The body of `POST /invoices`.
+#[derive(Clone, Debug, PartialEq)]
+pub struct NewInvoice {
+  /// `INV-` and 1 to 8 digits.
+  pub number: String,
+  /// 1 to 80 characters.
+  pub customer: String,
+  /// The receivable account.
+  pub account_id: i64,
+  /// Minor units, at least 1.
+  pub amount: i64,
+}
+
+impl HasSchema for NewInvoice {
+  type A = NewInvoice;
+  type I = (String, String, i64, i64);
+  type E = ();
+
+  fn schema() -> Schema<NewInvoice, (String, String, i64, i64)> {
+    schema::transform(
+      schema::struct4(
+        "number",
+        pattern(schema::string::<()>(), "^INV-[0-9]{1,8}$", |number| {
+          number.strip_prefix("INV-").is_some_and(|digits| {
+            (1..=8).contains(&digits.len()) && digits.bytes().all(|b| b.is_ascii_digit())
+          })
+        }),
+        "customer",
+        length(schema::string::<()>(), 1, 80),
+        "account_id",
+        minimum(schema::i64::<()>(), 1),
+        "amount",
+        minimum(schema::i64::<()>(), 1),
+      ),
+      |(number, customer, account_id, amount)| {
+        Ok::<_, ParseError>(NewInvoice {
+          number,
+          customer,
+          account_id,
+          amount,
+        })
+      },
+      |i: NewInvoice| (i.number, i.customer, i.account_id, i.amount),
+    )
+  }
+}
+
+/// The body of `PATCH /invoices/{id}`: the changes and the version they were made against.
+#[derive(Clone, Debug, PartialEq, id_effect::Schema)]
+pub struct InvoiceChanges {
+  /// A new customer (drafts only).
+  pub customer: Option<String>,
+  /// A new amount (drafts only).
+  pub amount: Option<i64>,
+  /// The next status (`issued` after `draft`, `paid` after `issued`).
+  pub status: Option<String>,
+  /// The `version` the client read; a newer one in the database is a `409`.
+  pub version: i64,
+}
+
+/// The open invoice `id` of the caller's organisation; `404` for any other.
+pub fn find_invoice(app: &App, caller: &Caller, id: i64) -> Effect<Invoice, ApiError> {
+  invoices_of(caller.org())
+    .on(Arc::clone(&app.db))
+    .find(id)
+    .map_err(ApiError::from)
+    .flat_map(|found| match found {
+      Some(invoice) => succeed(invoice),
+      None => fail(ApiError::NotFound("invoice")),
+    })
+}
+
+/// `invoice` with `changes` applied, or why they do not apply to it.
+pub fn apply(invoice: Invoice, changes: InvoiceChanges) -> Result<Invoice, ApiError> {
+  let draft = invoice.status == "draft";
+  if !draft && (changes.customer.is_some() || changes.amount.is_some()) {
+    return Err(ApiError::Conflict(format!(
+      "invoice {} is {}; only a draft's customer and amount change",
+      invoice.number, invoice.status
+    )));
+  }
+  if let Some(customer) = &changes.customer
+    && !(1..=80).contains(&customer.chars().count())
+  {
+    return Err(ApiError::invalid("/customer", "must be 1 to 80 characters"));
+  }
+  if changes.amount.is_some_and(|amount| amount < 1) {
+    return Err(ApiError::invalid("/amount", "must be at least 1"));
+  }
+  let status = match changes.status {
+    None => invoice.status.clone(),
+    Some(next) => {
+      let at = STATUSES.iter().position(|s| *s == invoice.status);
+      if STATUSES.iter().position(|s| *s == next) != at.map(|i| i + 1) {
+        return Err(ApiError::invalid(
+          "/status",
+          format!("an {} invoice cannot become {next}", invoice.status),
+        ));
+      }
+      next
+    }
+  };
+  Ok(Invoice {
+    customer: changes.customer.unwrap_or(invoice.customer),
+    amount: changes.amount.unwrap_or(invoice.amount),
+    status,
+    version: changes.version,
+    ..invoice
+  })
+}
+
+fn list(
+  env: &mut AppEnv,
+  caps: RequestCaps,
+  _: Input,
+) -> Effect<Json<InvoiceList>, ApiError, AppEnv> {
+  let app = Arc::clone(&env.0);
+  as_caller(&caps, move |caller| {
+    invoices_of(caller.org())
+      .on(Arc::clone(&app.db))
+      .find_all()
+      .map(|invoices| Json(InvoiceList { invoices }))
+      .map_err(ApiError::from)
+  })
+}
+
+fn raise(
+  env: &mut AppEnv,
+  caps: RequestCaps,
+  input: Input<(), (), (), NewInvoice>,
+) -> Effect<(StatusCode, Json<Invoice>), ApiError, AppEnv> {
+  let app = Arc::clone(&env.0);
+  let new = input.body;
+  as_caller(&caps, move |caller| {
+    // The account must be one of the caller's organisation: another's is a 422, not a 404.
+    find_account(&app, &caller, new.account_id)
+      .map_err(|_| ApiError::invalid("/account_id", "no such account"))
+      .flat_map(move |account| {
+        let invoice = Invoice {
+          id: 0,
+          org_id: caller.org().to_owned(),
+          number: new.number,
+          customer: new.customer,
+          account_id: account.id,
+          amount: new.amount,
+          status: "draft".to_owned(),
+          owner_id: caller.id().to_owned(),
+          version: 1,
+        };
+        // In a transaction: its errors carry the SQLSTATE, so a duplicate number answers 409.
+        let invoices = invoices_of(caller.org());
+        with_transaction(Arc::clone(&app.db), move |tx| {
+          invoices.on(tx).insert(invoice)
+        })
+        .map(|invoice| (StatusCode::CREATED, Json(invoice)))
+        .map_err(ApiError::from)
+      })
+  })
+}
+
+fn show(
+  env: &mut AppEnv,
+  caps: RequestCaps,
+  input: Input<i64>,
+) -> Effect<Json<Invoice>, ApiError, AppEnv> {
+  let app = Arc::clone(&env.0);
+  as_caller(&caps, move |caller| {
+    find_invoice(&app, &caller, input.path).map(Json)
+  })
+}
+
+fn update(
+  env: &mut AppEnv,
+  caps: RequestCaps,
+  input: Input<i64, (), (), InvoiceChanges>,
+) -> Effect<Json<Invoice>, ApiError, AppEnv> {
+  let app = Arc::clone(&env.0);
+  let Input {
+    path: id,
+    body: changes,
+    ..
+  } = input;
+  as_caller(&caps, move |caller| {
+    find_invoice(&app, &caller, id).flat_map(move |invoice| {
+      let allowed = caller.authorize(&app.policies, "invoice.manage", &invoice);
+      allowed.flat_map(move |()| match apply(invoice, changes) {
+        Ok(changed) => invoices_of(caller.org())
+          .on(Arc::clone(&app.db))
+          .update(changed)
+          .map(Json)
+          .map_err(ApiError::from),
+        Err(e) => fail(e),
+      })
+    })
+  })
+}
+
+fn void(
+  env: &mut AppEnv,
+  caps: RequestCaps,
+  input: Input<i64>,
+) -> Effect<StatusCode, ApiError, AppEnv> {
+  let app = Arc::clone(&env.0);
+  let id = input.path;
+  as_caller(&caps, move |caller| {
+    find_invoice(&app, &caller, id).flat_map(move |invoice| {
+      let allowed = caller.authorize(&app.policies, "invoice.manage", &invoice);
+      allowed.flat_map(move |()| {
+        if invoice.status == "paid" {
+          return fail(ApiError::Conflict(format!(
+            "invoice {} is paid; it cannot be voided",
+            invoice.number
+          )));
+        }
+        invoices_of(caller.org())
+          .on(Arc::clone(&app.db))
+          .delete(id)
+          .map(|_voided| StatusCode::NO_CONTENT)
+          .map_err(ApiError::from)
+      })
+    })
+  })
+}
+
+/// `/invoices` routes.
+pub fn routes(policies: &Policies) -> Router<AppEnv> {
+  Router::new()
+    .route(guarded(
+      policies,
+      "ledger.read",
+      Route::get("/invoices")
+        .response::<InvoiceList>(StatusCode::OK)
+        .handler_with_request_caps(list),
+    ))
+    .route(guarded(
+      policies,
+      "invoices.write",
+      Route::post("/invoices")
+        .body::<NewInvoice>()
+        .response::<Invoice>(StatusCode::CREATED)
+        .handler_with_request_caps(raise),
+    ))
+    .route(guarded(
+      policies,
+      "ledger.read",
+      Route::get("/invoices/{id}")
+        .path::<InvoiceId>()
+        .response::<Invoice>(StatusCode::OK)
+        .handler_with_request_caps(show),
+    ))
+    .route(guarded(
+      policies,
+      "invoices.write",
+      Route::patch("/invoices/{id}")
+        .path::<InvoiceId>()
+        .body::<InvoiceChanges>()
+        .response::<Invoice>(StatusCode::OK)
+        .handler_with_request_caps(update),
+    ))
+    .route(guarded(
+      policies,
+      "invoices.write",
+      Route::delete("/invoices/{id}")
+        .path::<InvoiceId>()
+        .handler_with_request_caps(void),
+    ))
+}
