{
	"realm": "ledger",
	"enabled": true,
	"sslRequired": "none",
	"roles": {
		"realm": [
			{ "name": "accountant", "description": "Reads and posts ledger entries" }
		]
	},
	"users": [
		{
			"username": "alice",
			"enabled": true,
			"email": "alice@example.com",
			"emailVerified": true,
			"firstName": "Alice",
			"lastName": "Accountant",
			"credentials": [
				{ "type": "password", "value": "alice-password", "temporary": false }
			],
			"realmRoles": ["accountant"]
		}
	],
	"clients": [
		{
			"clientId": "ledger-web",
			"name": "Ledger web (id_effect_auth OIDC test)",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"clientAuthenticatorType": "client-secret",
			"secret": "ledger-web-secret",
			"standardFlowEnabled": true,
			"implicitFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"redirectUris": ["*"],
			"webOrigins": ["+"],
			"attributes": {
				"pkce.code.challenge.method": "S256",
				"post.logout.redirect.uris": "+"
			},
			"protocolMappers": [
				{
					"name": "realm roles in the ID token",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-realm-role-mapper",
					"config": {
						"claim.name": "roles",
						"multivalued": "true",
						"jsonType.label": "String",
						"id.token.claim": "true",
						"access.token.claim": "true",
						"userinfo.token.claim": "true"
					}
				}
			]
		}
	]
}
