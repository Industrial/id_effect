//! The admin of [`{{entity}}`]: its list columns, search box and filters, generated by
//! `id-effect generate admin {{entity}}` from the entity's fields (edit them freely) and
//! registered in [`super::site`].
//!
//! Its pages are under `/admin/{{slug}}`, and each one checks a permission
//! `admin.{{slug}}.<action>` before any query. Nobody holds one until a role is granted it
//! ([`permissions`] lists them).
{{#if read_only}}
//!
//! Read-only: the list and detail pages only. [`super::policy`] refuses every other action on
//! it, whatever a role is granted.
{{/if}}

{{#if filters}}
use {{admin}}::{
    AdminAction, AdminConfigError, AdminPermission, AdminSite, EntityAdmin, Filter,
};
{{/if}}
{{#if !filters}}
use {{admin}}::{AdminAction, AdminConfigError, AdminPermission, AdminSite, EntityAdmin};
{{/if}}

use {{entity_path}};

/// The entity's name in its URLs and permissions.
pub const SLUG: &str = "{{slug}}";

{{#if read_only}}
/// The actions this admin offers: the list and detail pages (`--read-only`).
pub const ACTIONS: &[AdminAction] = &[AdminAction::List, AdminAction::View];
{{/if}}
{{#if !read_only}}
/// The actions this admin offers: list, view, create, update, delete and bulk, each its own
/// permission.
pub const ACTIONS: &[AdminAction] = &AdminAction::ALL;
{{/if}}

/// How the admin shows [`{{entity}}`] records: every name is a field of the entity, checked
/// against its `Entity::FIELDS` when the site is built.
pub fn admin() -> EntityAdmin<{{entity}}> {
    EntityAdmin::default()
        .slug(SLUG)
{{config}}
}

/// Adds the [`{{entity}}`] admin to `site`.
pub fn register(site: AdminSite) -> Result<AdminSite, AdminConfigError> {
    site.try_register(admin())
}

/// The permissions of [`ACTIONS`], `admin.{{slug}}.<action>`: the ones a role can be granted.
pub fn permissions() -> Result<Vec<AdminPermission>, AdminConfigError> {
    let info = admin().info()?;
    let offered = |permission: &AdminPermission| ACTIONS.contains(&permission.action());
    Ok(info.permissions.into_iter().filter(offered).collect())
}

#[cfg(test)]
mod tests {
    use std::sync::Arc;

    use {{admin}}::AdminDatabase;
    use id_effect_kit::authz::{
        BasicPrincipal, CurrentPrincipal, Decision, Guard, Policy, Rbac, require_role,
    };
    use {{sql}}::{Dialect, TestSqlClient};

    use super::*;
    use crate::admin::{PREFIX, policy, router};

    #[test]
    fn the_configuration_matches_the_entity() {
        let info = admin().info().expect("every name is a field of {{entity}}");
        assert_eq!(info.slug, SLUG);
        assert_eq!(info.list, [{{list}}]);
    }

    #[test]
    fn nothing_is_allowed_until_granted() {
        let policy = policy(Rbac::default()).expect("the admin builds");
        let nobody = CurrentPrincipal::new(BasicPrincipal::new("nobody"));
        for permission in admin().info().unwrap().permissions {
            let decision = policy.decide_now(&nobody, &permission);
            assert!(matches!(decision, Some(Decision::Deny(_))), "{permission}");
        }
    }

    #[test]
    fn only_the_offered_actions_can_be_granted() {
        let rbac = Rbac::builder().grant("root", ["*"]).build();
        let policy = policy(rbac).expect("the admin builds");
        let root = CurrentPrincipal::new(BasicPrincipal::new("root").with_role("root"));
        for permission in admin().info().unwrap().permissions {
            let allowed = policy.decide_now(&root, &permission) == Some(Decision::Allow);
            assert_eq!(
                allowed,
                ACTIONS.contains(&permission.action()),
                "{permission}"
            );
        }
        assert_eq!(permissions().unwrap().len(), ACTIONS.len());
    }

    #[test]
    fn every_page_is_behind_the_guard() {
        let db = AdminDatabase::new(Arc::new(TestSqlClient::new()), Dialect::Postgres);
        let guard = Guard::new("staff", require_role("staff"));
        let routes = router::<()>(guard, Rbac::default(), db).expect("the admin builds");
        let report = routes.access_report();
        assert!(report.public.is_empty(), "{:?}", report.public);
        let list = format!("GET {PREFIX}/{SLUG}");
        assert!(
            report
                .guarded
                .iter()
                .any(|(route, _)| route.as_str() == list)
        );
    }
}
