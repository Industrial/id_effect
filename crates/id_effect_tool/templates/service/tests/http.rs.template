/// In the `dev` profile every console request is the local operator; in any other profile
/// nobody is, so the console answers `401` until real authentication is added.
#[tokio::test]
async fn m6_loopback_operator_only_in_dev() {
    use {{crate_name}}::console::routes;

    let health = HealthRegistry::new();
{{#if !jobs}}
    let console = routes(&health, true);
    let prod = routes(&health, false);
{{/if}}
{{#if jobs}}
    let queue = id_effect_kit::jobs::MemoryJobQueue::new(id_effect::WallClock::system());
    let console = routes(&health, queue.clone(), true);
    let prod = routes(&health, queue, false);
    let (status, _, body) = call(&console, Method::GET, "/_console/api/jobs").await;
    assert_eq!(status, StatusCode::OK, "{body}");
{{/if}}
    let (status, _, body) = call(&console, Method::GET, "/_console/api/health").await;
    assert_eq!(status, StatusCode::OK, "{body}");
    let (status, _, _) = call(&console, Method::GET, "/_console").await;
    assert_eq!(status, StatusCode::OK);
    for path in ["/_console/api/health", "/_console"] {
        let (status, _, body) = call(&prod, Method::GET, path).await;
        assert_eq!(status, StatusCode::UNAUTHORIZED, "{path}: {body}");
    }
}

/// On its listener the console answers only its own host and origin (DNS rebinding).
#[tokio::test]
async fn m6_console_rejects_foreign_host_and_origin() {
    use id_effect_kit::console::ConsoleConfig;
    use {{crate_name}}::console::routes;

    let health = HealthRegistry::new();
{{#if !jobs}}
    let console = routes(&health, true);
{{/if}}
{{#if jobs}}
    let queue = id_effect_kit::jobs::MemoryJobQueue::new(id_effect::WallClock::system());
    let console = routes(&health, queue, true);
{{/if}}
    let console = ConsoleConfig::loopback(9090).check_host_and_origin(console);
    let get = |host: &'static str, origin: Option<&'static str>| {
        let request = Request::get("/_console/api/health").header("host", host);
        let request = match origin {
            Some(origin) => request.header("origin", origin),
            None => request,
        };
        console
            .clone()
            .oneshot(request.body(Body::empty()).unwrap())
    };
    let local = get("127.0.0.1:9090", Some("http://127.0.0.1:9090"))
        .await
        .unwrap();
    assert_eq!(local.status(), StatusCode::OK);
    let rebound = get("attacker.example:9090", None).await.unwrap();
    assert_eq!(rebound.status(), StatusCode::FORBIDDEN);
    let cross_site = get("127.0.0.1:9090", Some("https://attacker.example"))
        .await
        .unwrap();
    assert_eq!(cross_site.status(), StatusCode::FORBIDDEN);
}
