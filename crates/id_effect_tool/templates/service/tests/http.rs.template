//! The router in process: no socket, no database, no collector.

use axum::Router;
use axum::body::Body;
use axum::http::{HeaderMap, Method, Request, StatusCode};
use http_body_util::BodyExt;
use id_effect_kit::axum::HealthRegistry;
use id_effect_kit::axum::server::security::CookieKey;
use tower::ServiceExt;

use {{crate_name}}::app;

fn test_app() -> Router {
    app(&HealthRegistry::new(), CookieKey::generate())
}

async fn call(app: &Router, method: Method, uri: &str) -> (StatusCode, HeaderMap, String) {
    let request = Request::builder()
        .method(method)
        .uri(uri)
        .body(Body::empty())
        .unwrap();
    let (parts, body) = app.clone().oneshot(request).await.unwrap().into_parts();
    let bytes = body.collect().await.unwrap().to_bytes();
    let text = String::from_utf8_lossy(&bytes).into_owned();
    (parts.status, parts.headers, text)
}

#[tokio::test]
async fn index_answers_with_security_headers() {
    let (status, headers, body) = call(&test_app(), Method::GET, "/").await;
    assert_eq!(status, StatusCode::OK);
    assert!(body.starts_with("hello from"), "{body}");
    assert_eq!(headers["x-content-type-options"], "nosniff");
    assert!(headers.contains_key("content-security-policy"));
}

#[tokio::test]
async fn state_changing_requests_need_a_csrf_token() {
    let (status, _, body) = call(&test_app(), Method::POST, "/").await;
    assert_eq!(status, StatusCode::FORBIDDEN, "{body}");
}

#[tokio::test]
async fn health_and_ready_are_up() {
    let app = test_app();
    assert_eq!(call(&app, Method::GET, "/health").await.0, StatusCode::OK);
    let (status, _, body) = call(&app, Method::GET, "/ready").await;
    assert_eq!(status, StatusCode::OK, "{body}");
    assert!(body.contains("\"status\":\"up\""), "{body}");
}

#[tokio::test]
async fn metrics_count_requests_by_route() {
    let app = test_app();
    call(&app, Method::GET, "/").await;
    let (status, _, body) = call(&app, Method::GET, "/metrics").await;
    assert_eq!(status, StatusCode::OK);
    assert!(body.contains("greetings_total"), "{body}");
    let line = r#"http_server_requests_total{method="GET",route="/",status="200"}"#;
    assert!(body.contains(line), "{body}");
}

/// `--describe-layers` prints the layer graph (`id-effect doctor --graph`) and exits.
#[test]
fn describe_layers_prints_the_graph() {
    let out = std::process::Command::new(env!("CARGO_BIN_EXE_{{name}}"))
        .arg("--describe-layers")
        .output()
        .unwrap();
    assert!(out.status.success(), "{out:?}");
    let graph = String::from_utf8(out.stdout).unwrap();
    let summary = "layer graph: 2 layers, 1 edges, 0 missing\n";
    assert!(graph.starts_with(summary), "{graph}");
    let edge = "needs    ConfigProviderService <- env";
    assert!(graph.contains(edge), "{graph}");
}
