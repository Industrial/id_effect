//! The router in process: no socket, no database, no collector.

use axum::Router;
use axum::body::Body;
use axum::http::{HeaderMap, Method, Request, StatusCode};
use http_body_util::BodyExt;
use id_effect_kit::axum::HealthRegistry;
use id_effect_kit::axum::server::security::CookieKey;
use tower::ServiceExt;

use {{crate_name}}::app;

fn test_app() -> Router {
    app(&HealthRegistry::new(), CookieKey::generate())
}

async fn call(app: &Router, method: Method, uri: &str) -> (StatusCode, HeaderMap, String) {
    let request = Request::builder()
        .method(method)
        .uri(uri)
        .body(Body::empty())
        .unwrap();
    let (parts, body) = app.clone().oneshot(request).await.unwrap().into_parts();
    let bytes = body.collect().await.unwrap().to_bytes();
    let text = String::from_utf8_lossy(&bytes).into_owned();
    (parts.status, parts.headers, text)
}

#[tokio::test]
async fn index_answers_with_security_headers() {
    let (status, headers, body) = call(&test_app(), Method::GET, "/").await;
    assert_eq!(status, StatusCode::OK);
    assert!(body.starts_with("hello from"), "{body}");
    assert_eq!(headers["x-content-type-options"], "nosniff");
    assert!(headers.contains_key("content-security-policy"));
}

#[tokio::test]
async fn every_response_carries_a_request_id() {
    let (_, headers, _) = call(&test_app(), Method::GET, "/").await;
    assert!(headers.contains_key("x-request-id"), "{headers:?}");
}

#[tokio::test]
async fn typed_route_decodes_its_path_or_answers_a_problem() {
    let app = test_app();
    let (status, _, body) = call(&app, Method::GET, "/hello/ada").await;
    assert_eq!(status, StatusCode::OK, "{body}");
    assert_eq!(body, "hello, ada");
    let long = format!("/hello/{}", "a".repeat(33));
    let (status, headers, body) = call(&app, Method::GET, &long).await;
    assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY, "{body}");
    assert_eq!(headers["content-type"], "application/problem+json");
}

#[tokio::test]
async fn state_changing_requests_need_a_csrf_token() {
    let (status, _, body) = call(&test_app(), Method::POST, "/").await;
    assert_eq!(status, StatusCode::FORBIDDEN, "{body}");
}

#[tokio::test]
async fn health_and_ready_are_up() {
    let app = test_app();
    assert_eq!(call(&app, Method::GET, "/health").await.0, StatusCode::OK);
    let (status, _, body) = call(&app, Method::GET, "/ready").await;
    assert_eq!(status, StatusCode::OK, "{body}");
    assert!(body.contains("\"status\":\"up\""), "{body}");
}

/// `/metrics` answers only a scrape with the metrics token (`METRICS_TOKEN`), and counts
/// requests by route.
#[tokio::test]
async fn l2_template_metrics_not_public() {
    use id_effect_kit::axum::metrics::guarded_metrics_router;
    use {{crate_name}}::MetricsToken;

    let app = test_app();
    call(&app, Method::GET, "/").await;
    let (status, _, body) = call(&app, Method::GET, "/metrics").await;
    assert_eq!(status, StatusCode::UNAUTHORIZED, "{body}");
    assert!(!body.contains("greetings_total"), "{body}");

    let metrics: Router = guarded_metrics_router(MetricsToken::new("scrape"));
    let scrape = |token: &'static str| {
        Request::get("/metrics")
            .header("authorization", token)
            .body(Body::empty())
            .unwrap()
    };
    let wrong = metrics
        .clone()
        .oneshot(scrape("Bearer scrapf"))
        .await
        .unwrap();
    assert_eq!(wrong.status(), StatusCode::UNAUTHORIZED);
    let answer = metrics.oneshot(scrape("Bearer scrape")).await.unwrap();
    assert_eq!(answer.status(), StatusCode::OK);
    let bytes = answer.into_body().collect().await.unwrap().to_bytes();
    let body = String::from_utf8_lossy(&bytes);
    assert!(body.contains("greetings_total"), "{body}");
    let line = r#"http_server_requests_total{method="GET",route="/",status="200"}"#;
    assert!(body.contains(line), "{body}");
}

/// The app as generated passes the `prod` posture check (ADR 0013 R10): building it takes no
/// opt-out, and what `posture()` states about it (CSRF on, no `/docs`, no mesh, the console
/// guarded or absent) holds with the default in-flight cap.
#[test]
fn template_service_passes_prod_posture() {
    use id_effect_kit::axum::HostConfig;
    use id_effect_kit::posture::Posture;
    use {{crate_name}}::posture;

    let _app = test_app();
    let stated = posture(Posture::new("prod").host(&HostConfig::default()));
    let report = stated.check();
    assert!(report.passed(), "{report}");
    assert!(report.opt_outs().is_empty(), "{report}");
    assert!(report.enforce().is_ok());
}

/// Every route the app serves declares its access (ADR 0013 R1): the typed routes and
/// `plain_routes()` are the whole surface.
#[tokio::test]
async fn h8_every_template_route_declares_access() {
    use {{crate_name}}::plain_routes;

    let app = test_app();
    for info in plain_routes() {
        assert!(info.access.is_served(), "{} {}", info.method, info.path);
        let (status, _, body) = call(&app, Method::GET, &info.path).await;
        assert_ne!(status, StatusCode::NOT_FOUND, "{}: {body}", info.path);
    }
    let (status, _, _) = call(&app, Method::GET, "/nowhere").await;
    assert_eq!(status, StatusCode::NOT_FOUND);
}

/// A form larger than `BODY_LIMIT` is answered by the limit layer (a Problem), not by the CSRF
/// check reading it (plain text): the limit and timeout layers wrap the security layer.
#[tokio::test]
async fn m4_template_limit_layers_wrap_security_layer() {
    let form = vec![b'a'; {{crate_name}}::BODY_LIMIT + 1];
    let request = Request::post("/")
        .header("content-type", "application/x-www-form-urlencoded")
        .header("content-length", form.len())
        .body(Body::from(form))
        .unwrap();
    let answer = test_app().oneshot(request).await.unwrap();
    assert_eq!(answer.status(), StatusCode::PAYLOAD_TOO_LARGE);
    assert_eq!(answer.headers()["content-type"], "application/problem+json");
}

/// `--describe-layers` prints the layer graph (`id-effect doctor --graph`) and exits.
#[test]
fn describe_layers_prints_the_graph() {
    let out = std::process::Command::new(env!("CARGO_BIN_EXE_{{name}}"))
        .arg("--describe-layers")
        .output()
        .unwrap();
    assert!(out.status.success(), "{out:?}");
    let graph = String::from_utf8(out.stdout).unwrap();
    let summary = "layer graph: 2 layers, 1 edges, 0 missing\n";
    assert!(graph.starts_with(summary), "{graph}");
    let edge = "needs    ConfigProviderService <- env";
    assert!(graph.contains(edge), "{graph}");
}
