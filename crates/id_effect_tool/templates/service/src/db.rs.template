//! PostgreSQL: the connection pool, the migration in `migrations/` and the `db` readiness check.

use id_effect::Exit;
use id_effect_kit::axum::{EffectExecutor, HealthIndicator};
use id_effect_kit::sql::SqlClient;
use id_effect_kit::sql::pg::{PgPoolConfig, PgSqlClient, pg_pool_from_config};

/// The first migration. It is idempotent and runs on every start; move to a migration tool
/// (sqlx-cli, refinery) once the schema grows.
pub const MIGRATION_0001: &str = include_str!("../migrations/0001_init.sql");

/// A connected, migrated database.
#[derive(Clone)]
pub struct Database {
    client: PgSqlClient,
}

impl Database {
    /// Connects to `DATABASE_URL` and runs the migration.
    pub async fn connect() -> Result<Self, String> {
        let url = std::env::var("DATABASE_URL").map_err(|_| "DATABASE_URL is not set")?;
        let pool = pg_pool_from_config(PgPoolConfig::from_url(url))
            .await
            .map_err(|e| format!("database: {}", e.0))?;
        let client = PgSqlClient::new(pool);
        let migrate = client.execute(MIGRATION_0001, &[]);
        match EffectExecutor::global().run_effect(migrate).await {
            Exit::Success(_) => Ok(Self { client }),
            Exit::Failure(cause) => Err(format!("migration 0001: {cause:?}")),
        }
    }

    /// The SQL client (an `id_effect_kit::sql::SqlClient`).
    pub fn client(&self) -> &PgSqlClient {
        &self.client
    }

    /// The `db` check behind `/ready`: `SELECT 1` plus the pool's size and idle connections.
    pub fn health_indicator(&self) -> HealthIndicator {
        let client = self.client.clone();
        HealthIndicator::from_effect("db", move || client.pool_health())
    }
}
