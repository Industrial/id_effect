//! PostgreSQL: the connection pool, the migrations in `migrations/` and the `db` readiness check.

use id_effect::{Cause, Exit};
use id_effect_kit::axum::{EffectExecutor, HealthIndicator};
{{#if otel}}
use id_effect_kit::otel::instrumented_sql_client;
{{/if}}
use id_effect_kit::sql::migrate;
use id_effect_kit::sql::pg::{PgPoolConfig, PgSqlClient, pg_pool_from_config};
{{#if !otel}}
use id_effect_kit::sql::{SqlClientEnv, sql_client_env};
{{/if}}
{{#if otel}}
use id_effect_kit::sql::{SqlClientEnv, SqlClientService, sql_client_env};
{{/if}}

/// The migrations directory, read on start relative to the working directory (the project
/// root under `cargo run`, `/app` in the image). `id-effect migrate new <name>` adds one.
pub const MIGRATIONS_DIR: &str = "migrations";

/// A connected, migrated database.
#[derive(Clone)]
pub struct Database {
    client: PgSqlClient,
{{#if otel}}
    sql: SqlClientService,
{{/if}}
}

impl Database {
    /// Connects to `DATABASE_URL` and applies the pending migrations of [`MIGRATIONS_DIR`]: each
    /// in its own transaction under an advisory lock (replicas starting together apply it once),
    /// recorded in `_id_effect_migrations`. A migration changed after it was applied stops the
    /// start.
    pub async fn connect() -> Result<Self, String> {
        let url = std::env::var("DATABASE_URL").map_err(|_| "DATABASE_URL is not set")?;
        let pool = pg_pool_from_config(PgPoolConfig::from_url(url))
            .await
            .map_err(|e| format!("database: {}", e.0))?;
        let client = PgSqlClient::new(pool);
        let migrations = migrate::run::<SqlClientEnv, _>(MIGRATIONS_DIR)
            .provide_all(sql_client_env(client.clone()));
        match EffectExecutor::global().run_effect(migrations).await {
{{#if !otel}}
            Exit::Success(_applied) => Ok(Self { client }),
{{/if}}
{{#if otel}}
            Exit::Success(_applied) => Ok(Self {
                sql: instrumented_sql_client(SqlClientService::new(client.clone()), "postgresql"),
                client,
            }),
{{/if}}
            Exit::Failure(Cause::Fail(e)) => Err(format!("migrations: {e}")),
            Exit::Failure(cause) => Err(format!("migrations: {cause:?}")),
        }
    }

    /// The SQL client (an `id_effect_kit::sql::SqlClient`).
    pub fn client(&self) -> &PgSqlClient {
        &self.client
    }
{{#if otel}}

    /// The SQL capability for handlers (provide it as the `SqlClientService`): every `query` and
    /// `execute` runs in a `db.query` client span (`db.statement` with literals replaced by `?`;
    /// parameters never reach it), exported as a child of the request span, and is counted in
    /// the `db_client_*` metrics on `/metrics`.
    pub fn sql(&self) -> SqlClientService {
        self.sql.clone()
    }
{{/if}}

    /// The `db` check behind `/ready`: `SELECT 1` plus the pool's size and idle connections.
    pub fn health_indicator(&self) -> HealthIndicator {
        let client = self.client.clone();
        HealthIndicator::from_effect("db", move || client.pool_health())
    }
}
