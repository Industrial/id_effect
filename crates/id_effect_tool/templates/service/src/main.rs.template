//! {{name}}: serve the app until SIGINT / SIGTERM, then drain in-flight requests while `/ready`
//! answers `503` (for up to `SHUTDOWN_TIMEOUT_SECS`).
//!
//! Configuration comes from the environment (see `.env.example`). `--describe-layers` (or
//! `--describe-layers=dot`) prints the layer graph instead; `id-effect doctor --graph` runs it.

use std::process::ExitCode;

use id_effect_kit::axum::server::security::{COOKIE_KEY_ENV, CookieKey};
use id_effect_kit::axum::{
    HealthRegistry, HostBuilder, HostConfig, HostError, provide_host_config_env,
};
use id_effect_kit::graph::LayerGraph;
{{#if otel}}
use id_effect_kit::otel::{OtelConfig, install_from_config};
{{/if}}

{{#if pg}}
use {{crate_name}}::db::Database;
{{/if}}
use {{crate_name}}::{app, serve};

#[tokio::main]
async fn main() -> ExitCode {
    // HOST, PORT and SHUTDOWN_TIMEOUT_SECS from the environment (`HostBuilder` loads them the
    // same way when serving).
    let env = provide_host_config_env::<HostError>();
    let host_config = HostConfig::layer::<HostError>();
    // Register every layer the app composes, so the graph shows what each one needs.
    let graph = LayerGraph::new()
        .with("env", &env)
        .with("host-config", &host_config);
    if let Some(description) = graph.describe_if_requested(std::env::args()) {
        print!("{description}");
        return ExitCode::SUCCESS;
    }
{{#if otel}}
    // OTLP export of traces, metrics and logs, configured by the OTEL_* variables.
    let telemetry = match OtelConfig::from_env().and_then(install_from_config) {
        Ok(guard) => guard,
        Err(e) => return fail(format!("telemetry: {e}")),
    };
{{/if}}
    let cookie_key = match cookie_key() {
        Ok(key) => key,
        Err(e) => return fail(e),
    };
    let health = HealthRegistry::new();
{{#if pg}}
    let health = match Database::connect().await {
        Ok(db) => health.with_indicator(db.health_indicator()),
        Err(e) => return fail(e),
    };
{{/if}}
    let served = HostBuilder::new()
        .run_until_shutdown(move |host| {
            // `/ready` reports the host's readiness, which the shutdown signal marks down.
            let health = health.with_readiness(host.readiness.clone());
            serve(host, app(&health, cookie_key))
        })
        .await;
{{#if otel}}
    telemetry.shutdown();
{{/if}}
    match served {
        Ok(()) => {
            eprintln!("stopped");
            ExitCode::SUCCESS
        }
        Err(e) => fail(e),
    }
}

/// The cookie signing key from `COOKIE_KEY` (standard base64 of at least 64 bytes). Without
/// one a random key is used, so signed cookies do not survive a restart.
fn cookie_key() -> Result<CookieKey, String> {
    match std::env::var(COOKIE_KEY_ENV) {
        Ok(encoded) if !encoded.trim().is_empty() => {
            CookieKey::from_base64(&encoded).map_err(|e| format!("{COOKIE_KEY_ENV}: {e}"))
        }
        _ => {
            eprintln!("{COOKIE_KEY_ENV} is not set; using a random cookie key");
            Ok(CookieKey::generate())
        }
    }
}

fn fail(message: impl std::fmt::Display) -> ExitCode {
    eprintln!("error: {message}");
    ExitCode::FAILURE
}
