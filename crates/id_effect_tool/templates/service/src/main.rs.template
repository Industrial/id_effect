//! {{name}}: serve the app until SIGINT / SIGTERM, then drain in-flight requests while `/ready`
//! answers `503` (for up to `SHUTDOWN_TIMEOUT_SECS`).
//!
//! Configuration comes from the environment (see `.env.example`). `--describe-layers` (or
//! `--describe-layers=dot`) prints the layer graph instead; `id-effect doctor --graph` runs it.
//!
//! Before serving, the security posture check (ADR 0013 R10) prints its report; under the
//! `prod` profile (`ID_EFFECT_PROFILE=prod`) a failed probe stops the service. Accept an opt-out
//! with a reason under `[security.accepted_risks]` in `config/<profile>.toml`.
{{#if jobs}}
//!
//! A job worker runs in the same process: it starts before the server and, once the server has
//! stopped, drains the jobs in flight.
{{/if}}
{{#if console}}
//!
//! The operator console listens on `127.0.0.1:CONSOLE_PORT` (see `src/console.rs`).
{{/if}}

use std::process::ExitCode;

use id_effect_kit::axum::server::security::{COOKIE_KEY_ENV, CookieKey};
{{#if !jobs}}
use id_effect_kit::axum::{
    HealthRegistry, HostBuilder, HostConfig, HostError, provide_host_config_env,
};
{{/if}}
{{#if jobs}}
use id_effect_kit::axum::{
    EffectExecutor, HealthRegistry, HostBuilder, HostConfig, HostError, provide_host_config_env,
};
{{/if}}
use id_effect_kit::config::{EnvConfigProvider, Profiles};
use id_effect_kit::graph::LayerGraph;
{{#if otel}}
use id_effect_kit::otel::{OtelConfig, install_from_config};
{{/if}}
use id_effect_kit::posture::Posture;

{{#if console}}
use {{crate_name}}::console;
{{/if}}
{{#if pg}}
use {{crate_name}}::db::Database;
{{/if}}
{{#if jobs}}
use {{crate_name}}::jobs;
{{/if}}
{{#if !otel}}
use {{crate_name}}::{app, posture, serve};
{{/if}}
{{#if otel}}
use {{crate_name}}::{posture, serve, traced_app};
{{/if}}

#[tokio::main]
async fn main() -> ExitCode {
    // HOST, PORT and SHUTDOWN_TIMEOUT_SECS from the environment (`HostBuilder` loads them the
    // same way when serving).
    let env = provide_host_config_env::<HostError>();
    let host_config = HostConfig::layer::<HostError>();
    // Register every layer the app composes, so the graph shows what each one needs.
    let graph = LayerGraph::new()
        .with("env", &env)
        .with("host-config", &host_config);
    if let Some(description) = graph.describe_if_requested(std::env::args()) {
        print!("{description}");
        return ExitCode::SUCCESS;
    }
    // The security posture (ADR 0013 R10): the profile and the risks its configuration accepts,
    // what the app states about itself, the server's in-flight cap (`MAX_IN_FLIGHT`) and every
    // opt-out recorded so far. `prod` does not start on a failed probe; `dev` and `test` report.
    let host_settings = match HostConfig::config().load(&EnvConfigProvider::from_env()) {
        Ok(settings) => settings,
        Err(e) => return fail(e),
    };
    let stated = match Posture::load(&Profiles::new()) {
        Ok(base) => posture(base.host(&host_settings)),
        Err(e) => return fail(e),
    };
    match stated.check().enforce() {
        Ok(report) => eprint!("{report}"),
        Err(refused) => return fail(refused),
    }
{{#if otel}}
    // OTLP export of traces, metrics and logs, configured by the OTEL_* variables.
    let telemetry = match OtelConfig::from_env().and_then(install_from_config) {
        Ok(guard) => guard,
        Err(e) => return fail(format!("telemetry: {e}")),
    };
{{/if}}
    let cookie_key = match cookie_key() {
        Ok(key) => key,
        Err(e) => return fail(e),
    };
{{#if console}}
    let console_config = match console::config() {
        Ok(config) => config,
        Err(e) => return fail(e),
    };
{{/if}}
    let health = HealthRegistry::new();
{{#if pg}}
{{#if !jobs}}
    let health = match Database::connect().await {
        Ok(db) => health.with_indicator(db.health_indicator()),
        Err(e) => return fail(e),
    };
{{/if}}
{{#if jobs}}
    let db = match Database::connect().await {
        Ok(db) => db,
        Err(e) => return fail(e),
    };
    let health = health.with_indicator(db.health_indicator());
{{/if}}
{{/if}}
{{#if jobs}}
{{#if !pg}}
    let queue = jobs::queue();
{{/if}}
{{#if pg}}
    let queue = match jobs::queue(&db).await {
        Ok(queue) => queue,
        Err(e) => return fail(e),
    };
{{/if}}
{{/if}}
{{#if console}}
{{#if !jobs}}
    let console_routes = console::router(&health);
{{/if}}
{{#if jobs}}
    let console_routes = console::router(&health, queue.clone());
{{/if}}
    match console::spawn(console_config, console_routes).await {
        Ok(addr) => eprintln!("console on http://{addr}/_console"),
        Err(e) => return fail(e),
    }
{{/if}}
{{#if jobs}}
    // The worker drains when `stop_worker` fires, after the server has stopped.
    let (stop_worker, stopped) = tokio::sync::oneshot::channel::<()>();
    let worker = match jobs::worker(queue, async move {
        let _ = stopped.await;
    }) {
        Ok(worker) => worker,
        Err(e) => return fail(format!("jobs: {e}")),
    };
{{#if otel}}
    let worker = worker.with_span_hook(telemetry.span_hook());
{{/if}}
    let worker = tokio::spawn(EffectExecutor::global().run_effect(worker));
{{/if}}
{{#if otel}}
    let span_hook = telemetry.span_hook();
{{/if}}
    let served = HostBuilder::new()
        .run_until_shutdown(move |host| {
            // `/ready` reports the host's readiness, which the shutdown signal marks down.
            let health = health.with_readiness(host.readiness.clone());
{{#if !otel}}
            serve(host, app(&health, cookie_key))
{{/if}}
{{#if otel}}
            serve(host, traced_app(&health, cookie_key, span_hook))
{{/if}}
        })
        .await;
{{#if jobs}}
    let _ = stop_worker.send(());
    if let Err(e) = worker.await {
        eprintln!("jobs: the worker did not stop cleanly: {e}");
    }
{{/if}}
{{#if otel}}
    telemetry.shutdown();
{{/if}}
    match served {
        Ok(()) => {
            eprintln!("stopped");
            ExitCode::SUCCESS
        }
        Err(e) => fail(e),
    }
}

/// The cookie signing key from `COOKIE_KEY` (standard base64 of at least 64 bytes). Without
/// one a random key is used, so signed cookies do not survive a restart.
fn cookie_key() -> Result<CookieKey, String> {
    match std::env::var(COOKIE_KEY_ENV) {
        Ok(encoded) if !encoded.trim().is_empty() => {
            CookieKey::from_base64(&encoded).map_err(|e| format!("{COOKIE_KEY_ENV}: {e}"))
        }
        _ => {
            eprintln!("{COOKIE_KEY_ENV} is not set; using a random cookie key");
            Ok(CookieKey::generate())
        }
    }
}

fn fail(message: impl std::fmt::Display) -> ExitCode {
    eprintln!("error: {message}");
    ExitCode::FAILURE
}
