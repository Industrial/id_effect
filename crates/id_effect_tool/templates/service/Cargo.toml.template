[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
# One front door to id_effect: a feature per battery (web, openapi, sql-pg, migrate, auth,
# authz, otel, …; see the id_effect_kit docs).
id_effect_kit = { version = "{{id_effect_version}}", features = [{{kit_features}}] }
# The derive and `effect!` macros expand to `::id_effect::` paths; keep the core crate too.
id_effect = "{{id_effect_version}}"
# `#[rpc::service]` expands to `::id_effect_rpc::` paths: keep the RPC crate too (the kit's
# `rpc` feature picks its features).
id_effect_rpc = "{{id_effect_version}}"
axum = "0.8"
{{#if !jobs}}
{{#if !console}}
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
{{/if}}
{{#if console}}
# `net`: the console's listener.
tokio = { version = "1", features = ["macros", "net", "rt-multi-thread"] }
{{/if}}
{{/if}}
{{#if jobs}}
{{#if !console}}
# `sync`: the job worker's stop signal.
tokio = { version = "1", features = ["macros", "rt-multi-thread", "sync"] }
{{/if}}
{{#if console}}
# `net`: the console's listener; `sync`: the job worker's stop signal.
tokio = { version = "1", features = ["macros", "net", "rt-multi-thread", "sync"] }
{{/if}}
{{/if}}

[dev-dependencies]
http-body-util = "0.1"
# tests/shutdown.rs talks HTTP over a socket.
tokio = { version = "1", features = ["io-util", "net", "sync", "time"] }
tower = { version = "0.5", features = ["util"] }
