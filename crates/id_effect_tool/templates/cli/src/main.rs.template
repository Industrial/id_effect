//! {{name}}: clap → the program effect → `run_main` (Ctrl-C interrupts it, finalizers run,
//! exit 130), plus `completions <shell>`.

use std::process::ExitCode;

use clap::{Parser, Subcommand};
use id_effect_cli::completions::{self, CompletionsArgs};
use id_effect_kit::prelude::{RunMainConfig, run_main};

use {{crate_name}}::app;

#[derive(Parser, Debug)]
#[command(version, about, subcommand_negates_reqs = true)]
struct Cli {
    /// API token (loaded into config as `API_TOKEN`, then held as a `Secret`).
    #[arg(long, required = true)]
    token: Option<String>,
    #[command(subcommand)]
    command: Option<Command>,
}

#[derive(Subcommand, Debug)]
enum Command {
    /// Print a shell completion script to stdout.
    Completions(CompletionsArgs),
}

fn main() -> ExitCode {
    let cli = Cli::parse();
    match (cli.command, cli.token) {
        (Some(Command::Completions(args)), _) => {
            match completions::generate::<Cli>(&args, &mut std::io::stdout()) {
                Ok(()) => ExitCode::SUCCESS,
                Err(e) => {
                    eprintln!("error: {e}");
                    ExitCode::FAILURE
                }
            }
        }
        (None, Some(token)) => {
            let (program, env) = app(token);
            let program = program.map(|len| println!("token has {len} characters"));
            run_main(program, env, RunMainConfig::with_tracing())
        }
        // clap requires `--token` when no subcommand is given.
        (None, None) => ExitCode::from(2),
    }
}
