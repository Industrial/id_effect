//! Two nodes on one in-process fabric: remote spawn, cast and call; and two nodes over the
//! mutual-TLS mesh transport with the dev certificates.

use std::path::PathBuf;
use std::process::Command;

use id_effect::{Cause, Exit};
use id_effect_kit::node::{Cookie, MeshFabric, NodeId, RemoteFault, Session, Transport};
use id_effect_kit::posture::Posture;

use {{crate_name}}::{dev_certificates, mesh_certs, mesh_transport, node, posture, round_trip};

const BIN: &str = env!("CARGO_BIN_EXE_{{name}}");

/// A fresh directory under the system temp dir.
fn temp_dir(tag: &str) -> PathBuf {
    std::env::temp_dir().join(format!(
        "{}-{tag}-{}",
        env!("CARGO_PKG_NAME"),
        std::process::id()
    ))
}

/// Two nodes with the dev certificates authenticate each other over TLS, then run the cookie
/// handshake on the session.
#[tokio::test]
async fn dev_certificates_give_a_mutual_tls_session() {
    let dir = temp_dir("mtls");
    let certs = dev_certificates(&dir).expect("dev certificates");
    let dialer = mesh_transport(&certs).expect("dialer");
    let listener = mesh_transport(&certs)
        .expect("listener")
        .listen("127.0.0.1:0")
        .await
        .expect("bind");
    assert!(dialer.is_encrypted());
    let addr = listener.local_addr();
    let (dialed, accepted) = tokio::join!(dialer.connect(&addr), listener.accept());
    let cookie = Cookie::try_new("a-dev-cluster-cookie-of-at-least-32-bytes").expect("cookie");
    let (a, b) = (
        NodeId::from_parts("a@test", 1),
        NodeId::from_parts("b@test", 2),
    );
    let (to_b, to_a) = tokio::join!(
        Session::initiate(dialed.expect("dial"), &a, &cookie),
        Session::respond(accepted.expect("accept"), &b, &cookie),
    );
    assert_eq!(to_b.expect("initiator").peer(), &b);
    assert_eq!(to_a.expect("responder").peer(), &a);
    let _ = std::fs::remove_dir_all(dir);
}

/// The node as generated passes the `prod` posture check (ADR 0013 R10), and `prod` refuses
/// to run on dev certificates it did not name.
#[test]
fn the_cluster_passes_the_prod_posture_check() {
    let dir = temp_dir("posture");
    let transport =
        mesh_transport(&dev_certificates(&dir).expect("dev certificates")).expect("transport");
    let report = posture(Posture::new("prod"), &transport).check();
    assert!(report.passed(), "{report}");
    assert!(report.enforce().is_ok());
    assert!(mesh_certs("prod").is_err());
    let _ = std::fs::remove_dir_all(dir);
}

#[test]
fn a_counter_on_another_node_answers_calls() {
    let fabric = MeshFabric::new();
    let a = node("a@test", &fabric);
    let _b = node("b@test", &fabric);
    let remote = round_trip(&a, "b@test", 7).block_on();
    assert!(matches!(remote, Exit::Success(7)), "{remote:?}");
    let local = round_trip(&a, "a@test", 3).block_on();
    assert!(matches!(local, Exit::Success(3)), "{local:?}");
}

#[test]
fn an_unknown_node_is_a_remote_fault() {
    let fabric = MeshFabric::new();
    let a = node("a@test", &fabric);
    let exit = round_trip(&a, "nobody@test", 1).block_on();
    assert!(
        matches!(exit, Exit::Failure(Cause::Fail(RemoteFault::NoProc))),
        "{exit:?}"
    );
}

#[test]
fn the_binary_runs_the_round_trip() {
    let out = Command::new(BIN).output().expect("spawn the binary");
    assert_eq!(out.status.code(), Some(0), "{out:?}");
    assert!(String::from_utf8_lossy(&out.stdout).contains("= 42"));
}
