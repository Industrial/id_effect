{
  "name": "{{name}}",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "remoteUser": "dev",
{{#if service}}
  "containerEnv": {
    "HOST": "0.0.0.0",
    "PORT": "8080"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "{{name}}",
      "onAutoForward": "notify"
    }
  },
{{/if}}
{{#if pg}}
  "postCreateCommand": "cargo fetch && echo 'Dev loop: docker compose up -d db, then id-effect dev'",
{{/if}}
{{#if !pg}}
  "postCreateCommand": "cargo fetch && echo 'Dev loop: id-effect dev'",
{{/if}}
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"]
    }
  }
}
