# Copy to .env and adjust; the worker reads the process environment.
# The profile: dev (the default), test or prod. prod refuses to start on a failed security
# posture probe (printed at startup); accept an opt-out with a reason under
# [security.accepted_risks] in config/prod.toml.
ID_EFFECT_PROFILE=dev
# `run_main` installs tracing; RUST_LOG filters it.
RUST_LOG=info
